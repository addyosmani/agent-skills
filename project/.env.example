# Copy to .env at the project root and fill in. .env is never committed; this file holds no secret.
# Settings with a default show it; leave them commented out to keep it.

# --- Linear (skills/linear) ---
LINEAR_TEAM=
LINEAR_API_KEY=

# --- AWS: the profile the cloud scripts run as; its credentials stay on this machine (development-setup DS15) ---
AWS_PROFILE=
CLOUD_REGION=ap-southeast-2     # Asia Pacific (Sydney)

# --- Cloud dev machines (skills/development-setup/cloud.md, One-time setup) ---
CLOUD_SUBNET=                  # a subnet that assigns public addresses
CLOUD_SECURITY_GROUP=          # inbound TCP 22 from your address only
CLOUD_KEY_NAME=                # EC2 key pair; its private key in your SSH agent
CLOUD_SCHEDULER_ROLE_ARN=      # EventBridge Scheduler role: ec2:TerminateInstances, ec2:ReleaseHosts on brain=dev
# CLOUD_DEFAULT_TYPE=m8i.2xlarge  # any other type needs the user's permission (DS12); x86, as Android build tools need it
# CLOUD_MAX_MACHINES=2           # live dev machines before another needs permission (DS12)
# CLOUD_IDLE_MINUTES=30          # no SSH and no load for this long: terminated (DS13)
# CLOUD_MAX_HOURS=8              # deadline after the last agent joined (DS13)
# CLOUD_DISK_GB=100
# CLOUD_AMI=                     # default: latest Amazon Linux 2023 for the type's architecture
# CLOUD_MAX_CPU_PCT=70           # headroom thresholds for joining a machine (DS11)
# CLOUD_MAX_MEM_PCT=75
# CLOUD_MAX_DISK_PCT=80

# --- Mobile builds (DS16, DS17) ---
EXPO_TOKEN=                    # Expo access token for EAS Build
# EAS_FREE_BUILDS=15             # free builds per platform per month, then AWS
# EAS_MAX_QUEUE_MINUTES=30       # longer queue wait: cancel and build on AWS
CLOUD_MAC_AMI=                 # iOS on AWS only: macOS AMI with the pinned Xcode, Node, CocoaPods, EAS CLI
# CLOUD_MAC_TYPE=mac2.metal
