{
  "name": "@foreman-line/permission-profiles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Permission-profile registry schema, v0 registry document, and validator for the Foreman Line (permission-profile-registry goal, P1): named deny-first permission envelopes for dispatched sessions.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "permission-profiles": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/generate.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
