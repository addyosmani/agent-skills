{
  "name": "@foreman-line/skill-injection",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Skill injection matrix schema, v0 matrix document, and validator for the Foreman Line (W0-P5): which skills are injected at which pipeline role.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "skill-injection": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/generate.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
