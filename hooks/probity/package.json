{
  "name": "@jjchill/probity-rules",
  "version": "0.4.63",
  "description": "Versioned Probity rule presets and CLI tooling for the agent-skills catalog (test-driven-development, ports-and-adapters, acceptance-testing, spec-test parity, ubiquitous-language) — see hooks/PROBITY.md.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JJChill/agent-skills",
    "directory": "hooks/probity"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./rules/*": "./dist/rules/*.js",
    "./presets/*": "./dist/presets/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "probity-scope-report": "dist/scripts/scope-report.js",
    "probity-shadow-report": "dist/scripts/shadow-report.js",
    "probity-shadow-replay": "dist/scripts/shadow-replay.js",
    "probity-review-record": "dist/scripts/review-record.js",
    "probity-review-route": "dist/scripts/review-route.js",
    "probity-spec-parity": "scripts/spec-parity.mjs",
    "probity-claude": "scripts/probity-claude.mjs"
  },
  "files": [
    "dist",
    "scripts/spec-parity.mjs",
    "scripts/probity-claude.mjs",
    "kiro/kiro-agent.template.json",
    "kiro/kiro-transcript-to-claude.py",
    "kiro/probity-kiro-translate.py",
    "kiro/probity-kiro.sh",
    "kiro/skill-activation-forced-eval.sh",
    "kiro/README.md",
    "probity.config.ts",
    "probity.config.kotlin.ts",
    "probity.config.kmp.ts",
    "probity.config.swift.ts",
    "GLOSSARY.template.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nizos/probity": "^1.10.0"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@nizos/probity": "^1.10.1",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test rules/*.test.mts scripts/*.test.mjs",
    "test:kiro": "for f in kiro/*.test.py; do python3 \"$f\" || exit 1; done",
    "eval": "tsx evals/workflow-eval.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "optionalDependencies": {
    "@ast-grep/lang-kotlin": "0.0.7",
    "@ast-grep/napi": "0.45.1"
  }
}
